{
  "name": "dango-music",
  "productName": "Dango Music",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone always-on-top radio and YouTube Music overlay.",
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serifpersia/dango-music.git"
  },
  "license": "MIT",
  "author": "serifpersia",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node start.js dev",
    "build": "tsc --noEmit && vite build && pnpm run build:main",
    "build:main": "esbuild electron/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --external:electron --outfile=dist-electron/main.js",
    "start": "node start.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.2",
    "@xhayper/discord-rpc": "^1.3.4",
    "bgutils-js": "^4.0.3",
    "dotenv": "^17.4.2",
    "jsdom": "^30.1.3",
    "preact": "^10.29.1",
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.1"
  },
  "packageManager": "pnpm@11.27.0"
}
